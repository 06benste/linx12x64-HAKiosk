# Home Assistant login autofill, pre-baked into the image at install time.
# Copy to credentials.env (repo root, next to this file) before running
# scripts/02-install-kiosk.sh if you're pre-configuring a tablet for someone
# else rather than letting them use the on-screen setup wizard on first boot.
#
# Use a dedicated, non-admin HA user — this password is stored in plain text
# on the tablet under /opt/ha-kiosk/. Prefer Trusted Networks auth instead
# where possible (see docs/INSTALL.md).
HA_USER=kioskuser
HA_PASS=
