[Unit]
Description=Auto-rotate the kiosk display from the onboard accelerometer
After=multi-user.target ha-kiosk-power.service
Wants=ha-kiosk-power.service

[Service]
Type=simple
# Axis-to-direction mapping calibrated live against the real device — see
# auto-rotate.py's docstring.
Environment=AUTO_ROTATE_LIVE=1
ExecStart=/usr/bin/python3 /opt/ha-kiosk/scripts/auto-rotate.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
