# MQTT credentials for Home Assistant discovery of this tablet.
# Create a user in the Mosquitto add-on (or your broker), then fill these in.
MQTT_HOST=192.168.8.110
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_INTERVAL=15
# Prefer the HA switch `switch.hakiosk_camera` to enable/disable at runtime;
# CAMERA_ENABLED is only the default when /opt/ha-kiosk/config/camera_power
# does not exist yet. When off, ha-kiosk-camera-stream.service is stopped.
CAMERA_ENABLED=1
# Live MJPEG stream (ha-kiosk-camera-stream.service) — one long-lived HTTP
# multipart stream at CAMERA_STREAM_FPS. Point an HA mjpeg camera at
# /stream.mjpg for live video. Do NOT raise CAMERA_STREAM_MQTT_FPS for live.
CAMERA_STREAM_PORT=17824
CAMERA_STREAM_WIDTH=800
CAMERA_STREAM_HEIGHT=600
CAMERA_STREAM_FPS=15
# Low-rate JPEG stills for MQTT entity camera.hakiosk_camera_stream (thumbnail;
# shows whichever camera — front or rear — is currently selected).
# Keep this below 1/45Hz (~0.022) so camera-stream-server.py's 45s idle timer
# can actually stop the v4l2/ffmpeg capture pipeline between polls — at 1fps
# a poll always lands inside that window, so the pipeline (and the ISP behind
# it) never idles and burns power 24/7 just for an occasional thumbnail.
CAMERA_STREAM_MQTT=1
CAMERA_STREAM_MQTT_FPS=0.0167
# Dashboard screenshot → camera.hakiosk_screen (X11 grab via ffmpeg)
SCREENSHOT_ENABLED=1
SCREENSHOT_INTERVAL=30
SCREENSHOT_WIDTH=960
